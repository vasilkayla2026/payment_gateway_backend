# Copy to .env and fill in. Never commit .env.

PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/payment_gateway

# Razorpay Dashboard → Account & Settings → API Keys. Start with test-mode keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# The secret you type when adding the webhook in Razorpay Dashboard →
# Account & Settings → Webhooks. Razorpay calls it optional, but this server
# won't start without it. Generate one with: openssl rand -hex 32
# If yours contains #, wrap it in single quotes: dotenv treats an unquoted #
# as the start of a comment and drops the rest, so every signature fails.
RAZORPAY_WEBHOOK_SECRET=
